name = "marchesato-in-festa"
compatibility_date = "2026-09-01"
pages_build_output_dir = "."

[[d1_databases]]
binding = "DB"
database_name = "marchesato-in-festa"
database_id = "d86a9a4e-0e22-4f01-af4f-5f5ef7df1ca3"

[[r2_buckets]]
binding = "MEDIA"
bucket_name = "marchesato-media"

# Imposta da Cloudflare come secrets/variabili:
# ADMIN_PASSWORD
# SESSION_SECRET
# RESEND_API_KEY (opzionale)
# NOTIFY_EMAIL (opzionale)
# FROM_EMAIL (opzionale)
